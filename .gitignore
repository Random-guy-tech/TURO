# Ignore everything unless it is explicitly part of the website source.
# This excludes branding/, dist/, notes, reference images, prompts and local files.
/*

!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/site.config.json
!/index.html
!/styles.css
!/content.js
!/script.js

!/ar/
/ar/*
!/ar/index.html

!/assets/
/assets/*
!/assets/social-preview.png
!/assets/turo-logo.svg
!/assets/turo-icon.svg
!/assets/turo-icon.png

!/templates/
/templates/*
!/templates/page.html

!/scripts/
/scripts/*
!/scripts/build-pages.cjs
!/scripts/check-site.cjs
!/scripts/prepare-site.cjs

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/check.yml
!/.github/workflows/pages.yml
